# Kill switch configuration — copy to .env and adjust
# All values can also be set as Cloud Run environment variables

# --- Safety ---
DRY_RUN=true

# --- Allowlist (comma-separated, never shut down) ---
ALLOWLIST=prod-project-123,billing-host-project

# --- Action toggles ---
ENABLE_BILLING_SHUTOFF=false
ENABLE_RUN_PAUSE=false
ENABLE_TRIGGER_DISABLE=false
STOP_COMPUTE_INSTANCES=false
ENABLE_API_KEY_REVOKE=false
ENABLE_GKE_SCALE_DOWN=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Identity ---
PROJECT_ID=your-hub-project
# The project this service runs in. CloudManagement must NEVER execute the
# kill switch against its own project — doing so would create a feedback
# loop. Budget alerts for this project go to email, not the kill switch.
SELF_PROJECT_ID=your-hub-project
ALERT_TOPIC=budget-alerts

# --- Account registry (registry.py) ---
# USE_FIRESTORE=true uses Firestore in FIRESTORE_PROJECT (default: PROJECT_ID);
# otherwise falls back to the local YAML file at ACCOUNTS_FILE.
USE_FIRESTORE=false
ACCOUNTS_FILE=config/accounts.yaml
FIRESTORE_PROJECT=your-hub-project

# --- Real-time quota poller (poller.py, invoked via POST /poll) ---
BASELINE_MULTIPLIER=5
POLL_WINDOW_MINUTES=5
BASELINE_WINDOW_MINUTES=60

# --- Dashboard team view (dashboard.py) ---
HUB_PROJECT_ID=your-hub-project

# --- Intent/actual protocol (intent.py) ---
# Global fallback report token (per-project tokens take precedence via
# the registry's report_token_secret field)
CLOUDMANAGEMENT_REPORT_TOKEN=
# Shared secret for the Cloudflare Worker auth gate on cloud.magicsolutions.biz
# (sent as X-Gate-Token header by cloud_management_client). Set in Secret Manager.
CLOUDMANAGEMENT_GATE_TOKEN=
# Actual/expected ratio that triggers a per-job kill (default: 1.2 = 20% over)
INTENT_VARIANCE_THRESHOLD=1.2
# Multiplier on declared rate_limit_rpm before tripping (default: 1.1)
RATE_CAP_BUFFER=1.1

# --- Reconciliation tier ---
# BigQuery dataset for GCP billing export (one per billing account)
BQ_DATASET=cloud_billing_export
